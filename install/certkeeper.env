# ============================================================================
# CertKeeper — System Service Environment Overrides
# ============================================================================
# This file is loaded by the certkeeper systemd service.
# All values are optional — the app works out of the box with no configuration.
# Edit and uncomment any lines you need, then restart:
#   sudo systemctl restart certkeeper
# ============================================================================

# Server
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production

# Admin credentials — if omitted, create an account on first visit via the web UI.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Let's Encrypt
# LETSENCRYPT_EMAIL=you@example.com
# LETSENCRYPT_STAGING=false

# Cloudflare API token — can also be configured via the web UI.
# CLOUDFLARE_API_TOKEN=

# Paths (these match the system install layout — change only if needed)
DATA_DIR=/var/lib/certkeeper
LOG_DIR=/var/log/certkeeper
CERTBOT_CONFIG_DIR=/etc/letsencrypt
CERTBOT_WORK_DIR=/var/lib/letsencrypt

# Auto-renewal cron — if unset, a random twice-weekly schedule is generated.
# RENEWAL_CRON=0 3 * * *
