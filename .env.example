# ============================================================================
# CertKeeper — Environment Overrides (all optional)
# ============================================================================
# This file is entirely optional. The app works out of the box with no .env.
# Any value set here overrides the built-in default.
# ============================================================================

# Server (defaults: PORT=3000, HOST=0.0.0.0, NODE_ENV=production)
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production

# Disable HTTPS and run a plain HTTP server instead.
# Use this when TLS is terminated by an external proxy (e.g. Codespaces, nginx, Cloudflare Tunnel).
# USE_HTTP=true

# Session secret — auto-generated and stored in ./data/.session-secret if not set.
# Only set this if you need a specific value (e.g. shared across multiple instances).
# SESSION_SECRET=my-custom-secret

# Admin credentials — if omitted, you'll create an account on first visit.
# If set, these override the database credentials and password changes are disabled in the UI.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# Let's Encrypt staging mode (default: false)
# Set to "true" to use the staging server for testing.
# LETSENCRYPT_STAGING=false

# Registration email — if omitted, you'll set it via the web UI.
# If set, this overrides the database value and the UI field is disabled.
# LETSENCRYPT_EMAIL=you@example.com

# Cloudflare API token — can also be set in the web UI under Settings.
# If set here, this value takes priority over the UI setting.
# CLOUDFLARE_API_TOKEN=

# Paths (defaults work for both native and Docker)
# CERTBOT_CONFIG_DIR=/etc/letsencrypt
# CERTBOT_WORK_DIR=/var/lib/letsencrypt
# DATA_DIR=./data

# Auto-renewal cron schedule.
# If unset, a random twice-weekly early-morning schedule is generated automatically.
# Set this to override with your own cron expression (e.g. daily at 3am).
# RENEWAL_CRON=0 3 * * *

# Log directory (default: ./logs)
# App logs and certbot logs are both written here.
# App log: LOG_DIR/app.log (auto-rotated, 5 MB × 5 files).
# LOG_DIR=./logs
